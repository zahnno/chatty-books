# Base URL of the talkingbook server API. EXPO_PUBLIC_ vars are inlined into the
# JS bundle at build time and readable via process.env.
#
# - iOS simulator can reach your host machine at http://localhost:5001
# - Android emulator must use http://10.0.2.2:5001
# - A physical device must use your machine's LAN IP, e.g. http://192.168.1.20:5001
EXPO_PUBLIC_SERVER_URI=http://localhost:5001

# Google Sign-In client IDs (from Google Cloud Console). Required for the Google
# button on the login screen. Leave blank to disable that button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public web app URL — used for the "Manage subscription on the web" link.
EXPO_PUBLIC_WEB_URL=https://talkingbook.app
